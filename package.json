{
  "name": "seoflow",
  "version": "0.1.0",
  "private": true,
  "description": "Discover. Optimize. Rank. An evidence-first SEO workspace.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "better-auth": "^1.7.27",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.4",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.39.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.5.0",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "^0.31.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "0.28.2"
  }
}

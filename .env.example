# Core application URLs. Use your public HTTPS origin outside local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL is shared by the web app, worker, Better Auth, and pg-boss.
# Must be a postgres:// or postgresql:// URL. For managed providers, prefer the
# provider-recommended TLS parameters (e.g. ?sslmode=require / verify-full) in
# this URL — the driver then verifies certificates. Do not disable verification.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seoflow
# Optional TLS controls when the URL has no sslmode parameter:
#   disable  -> plain TCP (private networks only)
#   require  -> TLS with default certificate verification (recommended for production)
#   no-verify -> TLS without certificate verification (LAST RESORT; provider must be trusted)
# DATABASE_SSL=
# Optional CA certificate (PEM) for verified TLS against a private CA:
# DATABASE_CA_CERT=
# Optional pool controls (valid ranges: pool 1-100, connect timeout 500-60000 ms):
# PG_POOL_MAX=
# DATABASE_CONNECTION_TIMEOUT_MS=
# Optional per-statement timeout applied to every query (1000-120000 ms, default 15000):
# DATABASE_QUERY_TIMEOUT_MS=
# Optional bearer key for the detailed, non-public diagnostics endpoints
# (/api/health/database and /api/health/auth). When unset, only an authenticated
# super-admin session can read them. Generate with: openssl rand -base64 32
# HEALTH_DIAGNOSTICS_KEY=

# Generate independently with: openssl rand -base64 32
# BETTER_AUTH_SECRET must be set in production; build-time fallback is not a runtime secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Base64 encoding of exactly 32 random bytes; encrypts AI, Google and payment-management secrets.
SECRETS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Optional SMTP. In local development only, verification/reset links are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SEOFlow <no-reply@example.com>

# Optional Amazon SES for transactional mail (verification, password reset, invitations).
# Preferred on the Vercel AWS integration (role-based, no stored keys). When EMAIL_PROVIDER
# is blank or "smtp", SMTP_* above is used unchanged. Set EMAIL_PROVIDER=ses to switch.
# There is no silent fallback between providers. SES_FROM_EMAIL (or SMTP_FROM) must be a
# verified sender identity in SES, in AWS_REGION; DKIM/SPF must pass for the domain.
EMAIL_PROVIDER=
SES_FROM_EMAIL=

# AWS. Two supported credential strategies — never use both for the same purpose:
#   1) Vercel AWS integration (recommended): the integration injects AWS_REGION,
#      AWS_ACCOUNT_ID, AWS_RESOURCE_ARN, AWS_ROLE_ARN, S3_BUCKET_NAME as sensitive vars.
#      Vercel also injects VERCEL_OIDC_TOKEN per deployment; the app exchanges it for
#      temporary credentials via STS AssumeRoleWithWebIdentity. No keys are stored.
#   2) Static S3-compatible credentials (fallback / MinIO / non-AWS endpoints):
#      S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY with S3_BUCKET and S3_REGION.
# AWS_REGION is set by the Vercel integration; do not paste values into the repository.
AWS_REGION=
AWS_ROLE_ARN=
AWS_ACCOUNT_ID=
AWS_RESOURCE_ARN=
# Optional CloudWatch operational metrics (aws sdk PutMetricData). Disabled by default;
# when true, uses the shared AWS credential resolution. Namespace defaults to "SEOFlow".
AWS_CLOUDWATCH_METRICS=
AWS_CLOUDWATCH_NAMESPACE=

# Optional Google sign-in; configure both values to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Search Console OAuth. Register the redirect URI exactly with Google Cloud.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:3000/api/google/search-console/callback

# Optional recurring billing. Also configure Stripe monthly Price IDs or Paystack Plan Codes
# for each paid plan in Dashboard > Admin > Plans. Webhooks are signature-verified and idempotent.
# Set to exactly "stripe" or "paystack" when ready; leave blank to disable checkout.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
# Paystack signs with its secret API key by default; set this explicitly to override that behavior.
PAYSTACK_WEBHOOK_SECRET=

# Optional paid SEO data source. Calls are user-triggered, rate-limited and recorded with provider costs
# when DataForSEO returns a cost value. A project target country is required for localized metrics.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# App-level per-user API write limit (one-minute window); production deployments should also enforce
# edge/WAF limits for unauthenticated and infrastructure-level traffic.
API_RATE_LIMIT_PER_MINUTE=60

# Safe-crawling resource controls. The worker also respects robots.txt and public DNS-pinned destinations.
CRAWL_MAX_PAGES_HARD_LIMIT=10000
CRAWL_REQUEST_TIMEOUT_MS=12000
CRAWL_MAX_RESPONSE_BYTES=2097152
CRAWL_USER_AGENT=SEOFlowBot/1.0

# Optional private report archive on AWS S3 or an S3-compatible object store.
# When nothing is configured (neither the Vercel AWS integration nor S3_* values below),
# exports remain generated on demand and streamed to authorized users.
# Two ways to enable it — see the AWS section above:
#   1) Vercel AWS integration: set AWS_REGION + S3_BUCKET_NAME + AWS_ROLE_ARN via the
#      integration; no S3_* values needed here. The app uses Vercel OIDC + STS.
#   2) Static credentials for AWS or an S3-compatible store: set all four required
#      values together (S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoints (for example, MinIO) default to path-style addressing. Override only when needed.
S3_FORCE_PATH_STYLE=

# Set this before first startup when bootstrapping the initial platform administrator account.
ADMIN_EMAIL=

# Vercel consolidation transition (see docs/DEPLOYMENT.md). Set ONLY on the duplicate
# project (`seo-fl-ow`) to 308 every request to the canonical deployment. Leave unset
# on the canonical project (`seoflow`).
REDIRECT_SECONDARY_HOST=
CANONICAL_APP_ORIGIN=
